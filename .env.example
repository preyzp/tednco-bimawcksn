# Resend email delivery. Use an address/domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=Bima Wicksn <inquiries@your-verified-domain.com>

# Durable rate limiting (Upstash Redis REST). The API token is also used to HMAC the visitor IP.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# International phone number with country code, digits only. Ex: 6281234567890
WHATSAPP_NUMBER=
